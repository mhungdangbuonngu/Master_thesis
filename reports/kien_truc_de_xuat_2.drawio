<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="page1" name="1. Kiến trúc SynergyGNN">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1title" value="&lt;b&gt;Trang 1 — Khối A: SynergyGNN, một lượt forward đầy đủ&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1sub" value="Số chiều trong hình là ví dụ cụ thể để dễ hình dung: 2.000 gen, 20.000 cạnh, hidden 32. Màu xanh dương = dữ liệu / tensor. Xanh lá = phép tính có tham số. Vàng = ghi chú thiết kế." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="48" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="trip" value="&lt;b&gt;Một mẫu = bộ ba (thuốc A, thuốc B, cell line c)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="95" width="370" height="45" as="geometry" />
        </mxCell>

        <mxCell id="src1" value="&lt;b&gt;DepMap biểu hiện gen&lt;/b&gt;&lt;br&gt;lấy cột của cell c, đã z-score theo gen&lt;br&gt;(z-score để mốc 0 = trung bình)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="180" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="src2" value="&lt;b&gt;Bảng đích thuốc&lt;/b&gt;&lt;br&gt;DrugBank / ChEMBL&lt;br&gt;tA(g), tB(g) thuộc {0, 1}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="310" y="180" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="src3" value="&lt;b&gt;STRING v12&lt;/b&gt;&lt;br&gt;combined_score ≥ 700&lt;br&gt;lọc 2 bước quanh tập đích thuốc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="180" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="trip" target="src1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="trip" target="src2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="X" value="&lt;b&gt;X — đặc trưng node (mỗi gen 3 con số)&lt;/b&gt;&lt;br&gt;&lt;br&gt;X[g] = [ expr_c(g) ,  tA(g) + tB(g) ,  tA(g) · tB(g) ]&lt;br&gt;&lt;br&gt;kích thước [ n_gen × 3 ] = [ 2000 × 3 ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="290" width="390" height="100" as="geometry" />
        </mxCell>
        <mxCell id="E" value="&lt;b&gt;edge_index&lt;/b&gt; [ 2 × 20000 ]&lt;br&gt;&lt;br&gt;&lt;b&gt;m&lt;/b&gt; — mask cạnh [ 20000 ]&lt;br&gt;mặc định m = 1 cho mọi cạnh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="290" width="390" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="src1" target="X">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="src2" target="X">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="src3" target="E">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="nsym" value="&lt;b&gt;Vì sao dùng tổng và tích?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hoán đổi A với B: tA+tB không đổi, tA·tB không đổi, nên X không đổi, nên dự đoán không đổi.&lt;br&gt;&lt;br&gt;Hiệp đồng là quan hệ đối xứng, nên mô hình đối xứng ngay từ thiết kế thay vì phải học điều đó." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="420" width="250" height="160" as="geometry" />
        </mxCell>

        <mxCell id="Ahat" value="&lt;b&gt;Dựng ma trận kề có mask&lt;/b&gt;&lt;br&gt;&lt;br&gt;A_m = A ⊙ m   (nhân trọng số từng cạnh với m_e)&lt;br&gt;Â_m = D^(-1/2) · (A_m + I) · D^(-1/2)&lt;br&gt;&lt;br&gt;D là bậc tính TRÊN A_m + I, không phải trên A gốc.&lt;br&gt;Dựng lại mỗi lượt forward. Kết quả: sparse [ 2000 × 2000 ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="390" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="E" target="Ahat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="nm" value="&lt;b&gt;m là trục mà explainer đi dọc theo&lt;/b&gt;&lt;br&gt;&lt;br&gt;m = 1 → Â_m đúng bằng Â của GCN thường. Viết một test cho đúng điều này.&lt;br&gt;&lt;br&gt;m = 0 → A_m = 0, chỉ còn tự vòng I, không gen nào nhận tin từ gen khác. Đây là &quot;mô hình không có mạng&quot;, và là mốc baseline của Integrated Gradients.&lt;br&gt;&lt;br&gt;Mask phải nằm trong forward từ đầu, vì edge-IG lấy đạo hàm của đầu ra theo từng m_e. Vá sau thì không lấy được." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="420" width="280" height="250" as="geometry" />
        </mxCell>

        <mxCell id="gcn1" value="&lt;b&gt;GCN lớp 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;H1 = ReLU( Â_m · X · W1 )&lt;br&gt;W1 [ 3 × 32 ]  →  H1 [ 2000 × 32 ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="610" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="Ahat" target="gcn1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="X" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="X" target="gcn1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="340" />
              <mxPoint x="490" y="655" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="gcn2" value="&lt;b&gt;GCN lớp 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;H2 = ReLU( Â_m · H1 · W2 )&lt;br&gt;W2 [ 32 × 32 ]  →  H2 [ 2000 × 32 ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="730" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="gcn1" target="gcn2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="dùng lại cùng Â_m" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="Ahat" target="gcn2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="490" />
              <mxPoint x="1080" y="775" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="nhop" value="&lt;b&gt;2 lớp = mỗi gen chỉ &quot;thấy&quot; 2 bước&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trước khi train, đếm phân bố khoảng cách giữa đích của A và đích của B trên mạng.&lt;br&gt;&lt;br&gt;Nếu phần lớn cặp cách nhau hơn 2 bước thì thông tin hai nhánh KHÔNG BAO GIỜ gặp nhau trong mô hình, và mọi đường dẫn bạn đọc ra sau đó đều vô nghĩa. Lúc đó phải tăng số lớp hoặc nới bán kính lọc." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="700" width="280" height="190" as="geometry" />
        </mxCell>

        <mxCell id="proj" value="&lt;b&gt;Chiếu từng gen xuống 4 chiều&lt;/b&gt;&lt;br&gt;&lt;br&gt;P = H2 · W3&lt;br&gt;W3 [ 32 × 4 ]  →  P [ 2000 × 4 ]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="850" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="gcn2" target="proj">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flat" value="&lt;b&gt;Flatten&lt;/b&gt;&lt;br&gt;&lt;br&gt;h = vec(P)  →  vector [ 8000 ]&lt;br&gt;xếp nối 2000 gen × 4 chiều, giữ đúng thứ tự gen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="970" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="proj" target="flat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="nflat" value="&lt;b&gt;Flatten, KHÔNG mean-pool&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mean-pool trộn mọi gen thành một vector duy nhất. Danh tính gen biến mất, nên attribution lên từng gen mất nghĩa, mà đó chính là thứ luận văn cần đọc.&lt;br&gt;&lt;br&gt;Giá phải trả: tầng kế tiếp có 8000 × 128 ≈ 1,02 triệu tham số, và số đó tăng theo số gen. Đây là lý do phải lọc mạng còn khoảng 2.000 gen (mục 2.4)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="930" width="280" height="200" as="geometry" />
        </mxCell>

        <mxCell id="mlp" value="&lt;b&gt;MLP đầu đọc&lt;/b&gt;&lt;br&gt;&lt;br&gt;8000 → 128  (ReLU, dropout 0,3)  → 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="1090" width="390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="flat" target="mlp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="nemb" value="&lt;b&gt;Chỗ bản 2 khác bản 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bản 1 ghép thêm embedding thuốc [ eA + eB , eA · eB ] vào vector h ngay trước MLP.&lt;br&gt;&lt;br&gt;Bản 2 BỎ nó. Embedding thuốc là đường tắt để mô hình nhớ danh tính cặp, mà danh tính đúng là thứ RQ2 muốn loại trừ. Bỏ đi thì mô hình buộc phải đi qua cờ đích trên mạng.&lt;br&gt;&lt;br&gt;Hệ quả: QWK sẽ thấp hơn các bài đã công bố. Phải báo cáo rõ, và chạy thêm một bản CÓ embedding để đối chiếu." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=16;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="1090" width="280" height="240" as="geometry" />
        </mxCell>

        <mxCell id="logit" value="&lt;b&gt;z = ( z_ant , z_add , z_syn )&lt;/b&gt;   [ 3 ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="620" y="1200" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="mlp" target="logit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="soft" value="softmax(z) → xác suất 3 lớp (ant / add / syn)&lt;br&gt;&lt;br&gt;Loss: cross-entropy có trọng số lớp = 1 / tần suất lớp&lt;br&gt;(ở ngưỡng ±10 lớp add thường chiếm đa số)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="1300" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="logit" target="soft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="nout" value="&lt;b&gt;Ba logit này là đầu vào của explainer (trang 2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cấp (i) dùng z_syn&lt;br&gt;Cấp (ii) và (iii) dùng Δ = z_syn − z_add&lt;br&gt;&lt;br&gt;Explainer lấy đạo hàm của số vô hướng này theo m, chứ không theo X. Mạng là thứ đang bị chất vấn, không phải biểu hiện gen." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="1200" width="280" height="190" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page2" name="2. Explainer edge-IG">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2title" value="&lt;b&gt;Trang 2 — Khối D: edge-IG, ba cấp giải thích, và cách ra đường dẫn&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2sub" value="Mô hình đã train xong và không đổi nữa. Toàn bộ trang này là hậu kiểm: chỉ đọc mô hình, không train thêm." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="48" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="frozen" value="&lt;b&gt;Mô hình A đã train, đóng băng tham số&lt;/b&gt;&lt;br&gt;+ một bộ ba test (A, B, c) mà mô hình dự đoán là syn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="95" width="520" height="60" as="geometry" />
        </mxCell>

        <mxCell id="pickf" value="Chọn đại lượng vô hướng &lt;b&gt;f(m)&lt;/b&gt; cần giải thích" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="195" width="320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="frozen" target="pickf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="lv1" value="&lt;b&gt;Cấp (i) — logit&lt;/b&gt;&lt;br&gt;&lt;br&gt;f = z_syn&lt;br&gt;&lt;br&gt;Cạnh nào đẩy logit syn lên?&lt;br&gt;&lt;br&gt;&lt;i&gt;Đây là cách gần như mọi bài đã công bố đang làm.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="290" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lv2" value="&lt;b&gt;Cấp (ii) — contrast&lt;/b&gt;&lt;br&gt;&lt;br&gt;f = Δ = z_syn − z_add&lt;br&gt;&lt;br&gt;Vì sao là syn chứ không phải add?&lt;br&gt;&lt;br&gt;Trừ đi phần nền chung mà mọi lớp đều có." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="290" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lv3" value="&lt;b&gt;Cấp (iii) — interaction&lt;/b&gt;&lt;br&gt;&lt;br&gt;f = Δ(A,B) − E_r Δ(A,r) − E_r Δ(r,B) + E_(r,r&#39;) Δ(r,r&#39;)&lt;br&gt;&lt;br&gt;Phần nào thuộc riêng về CẶP, sau khi trừ hiệu ứng riêng của từng thuốc. r là thuốc tham chiếu, lấy trung bình qua các thuốc khác, cùng cell c.&lt;br&gt;&lt;br&gt;Cùng cấu trúc với sai phân bậc hai của Shapley interaction index (Grabisch &amp;amp; Roubens 1999)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="770" y="290" width="360" height="220" as="geometry" />
        </mxCell>

        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="pickf" target="lv1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="pickf" target="lv2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="pickf" target="lv3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ig" value="&lt;b&gt;edge-IG — Integrated Gradients theo mask cạnh m&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đường tích phân:  m(α) = α · 1 ,  α đi từ 0 (mạng rỗng) tới 1 (mạng đầy đủ)&lt;br&gt;&lt;br&gt;φ_e = (1 − 0) · ∫₀¹  ∂f( m(α) ) / ∂m_e   dα&lt;br&gt;&lt;br&gt;Xấp xỉ Riemann điểm giữa, S = 50 bước:  α_s = (s − 0,5) / S ,  s = 1 .. 50&lt;br&gt;Mỗi bước: 1 forward + 1 backward theo m. Tổng 50 forward-backward cho một bộ ba.&lt;br&gt;&lt;br&gt;Vì sao baseline là m = 0 mà không phải X = 0: câu hỏi của luận văn là MẠNG đóng góp gì, nên đi dọc trục mạng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="700" height="210" as="geometry" />
        </mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="lv1" target="ig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="lv2" target="ig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lv3" target="ig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ncost" value="&lt;b&gt;Chi phí của cấp (iii), và cách làm cho nó chạy được&lt;/b&gt;&lt;br&gt;&lt;br&gt;IG tuyến tính theo f, nên không cần chạy IG trên công thức ghép. Chạy IG riêng rồi cộng trừ:&lt;br&gt;&lt;br&gt;φ(iii) = φ(A,B) − mean_r φ(A,r) − mean_r φ(r,B) + mean_(r,r&#39;) φ(r,r&#39;)&lt;br&gt;&lt;br&gt;Cache: số hạng cuối chỉ phụ thuộc cell c, tính một lần mỗi cell. Số hạng giữa tính một lần mỗi (thuốc, cell).&lt;br&gt;&lt;br&gt;Nếu vẫn chậm: lấy mẫu 8 thuốc tham chiếu, rồi báo kết quả đổi bao nhiêu khi tăng lên 16." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="560" width="360" height="250" as="geometry" />
        </mxCell>

        <mxCell id="phi" value="&lt;b&gt;φ ∈ R^20000&lt;/b&gt; — điểm đóng góp của TỪNG CẠNH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="180" y="820" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="ig" target="phi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="br1" value="&lt;b&gt;Nhánh 1 — điều kiện tiên quyết (chạy TRƯỚC, bắt buộc)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Completeness của IG:  Σ_e φ_e  =  f(m=1) − f(m=0)&lt;br&gt;Đây là đẳng thức đúng, không phải xấp xỉ, nên dùng được làm phép kiểm tra cài đặt.&lt;br&gt;&lt;br&gt;&lt;b&gt;network share = ( Σ_e φ_e ) / f(m=1)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gần 0 → mô hình gần như không dùng mạng → mọi đường dẫn đọc ra sau đó là vô nghĩa.&lt;br&gt;&lt;br&gt;Đối chiếu độc lập: train lại một mô hình với m cố định = 0. QWK(m=1) có hơn QWK(m=0) không?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="940" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="phi" target="br1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Chuẩn hóa |φ_e| về khoảng (0, 1]  →  p_e" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="940" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="phi" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;Chi phí cạnh:  c_e = − log(p_e) + λ&lt;/b&gt;&lt;br&gt;&lt;br&gt;− log biến tổng chi phí thành TÍCH các điểm, nên đường dài hơn vẫn có thể thắng. Ví dụ: hai cạnh 0,9 và 0,8 cho 0,328; ba cạnh 0,9 cho 0,316 → đường ba cạnh thắng.&lt;br&gt;&lt;br&gt;λ là phạt cố định mỗi cạnh để ưu tiên đường ngắn. Nó đổi kết quả, nên phải ghi giá trị vào luận văn." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="1020" width="440" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;k đường ngắn nhất&lt;/b&gt; giữa MỌI cặp (đích của A, đích của B)&lt;br&gt;networkx.shortest_simple_paths, gộp rồi xếp hạng theo tổng chi phí" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="1210" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;Đầu ra: top-k GEN  và  top-k ĐƯỜNG DẪN&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="1310" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="mets" value="&lt;b&gt;Khối E — mọi chỉ số tính HAI lần (cấp gen và cấp đường dẫn) và LUÔN trừ null&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fid+ / Fid−  ←  null: xoá cùng số lượng cạnh ngẫu nhiên, 20 lần, lấy trung bình&lt;br&gt;Stability  ←  cosine giữa 5 seed&lt;br&gt;Rewiring-survival (RQ1)  ←  null: survival giữa hai mạng xáo độc lập&lt;br&gt;Partner-specificity (RQ2)  ←  null: specificity của explainer đường ngắn nhất&lt;br&gt;Positive-control hit  ←  null: 1.000 đường ngẫu nhiên cùng độ dài&lt;br&gt;&lt;br&gt;&lt;b&gt;Mọi null phải đi qua ĐÚNG bộ trích đường dẫn ở trên.&lt;/b&gt; Nếu null tính ở cấp cạnh mà kết quả thật ở cấp đường dẫn thì chênh lệch có thể đến từ bước trích đường, không phải từ explainer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="1420" width="1100" height="190" as="geometry" />
        </mxCell>
        <mxCell id="f14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="n4" target="mets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="br1" target="mets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page3" name="3. Toàn bộ thí nghiệm">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1665" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3title" value="&lt;b&gt;Trang 3 — Khung thí nghiệm: A, B, C, D, E ghép lại&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3sub" value="Chỉ khối A là mô hình. B là mốc so sánh. C là bốn phiên bản ĐẦU VÀO của chính A, không phải bốn mô hình khác nhau. Một kiến trúc GCN duy nhất, train 100 lần." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="48" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="prep" value="&lt;b&gt;Chuẩn bị dữ liệu&lt;/b&gt;  →  một file .pt&lt;br&gt;O&#39;Neil (DrugComb, study_name = ONEIL) + DepMap biểu hiện + đích thuốc + STRING ≥ 700&lt;br&gt;Nhãn 3 lớp theo Loewe: syn &amp;gt; 10, add −10..10, ant &amp;lt; −10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="95" width="610" height="80" as="geometry" />
        </mxCell>

        <mxCell id="split" value="&lt;b&gt;Split leave-combo&lt;/b&gt;&lt;br&gt;cặp (A, B) trong test chưa từng xuất hiện ở train, nhưng A và B vẫn gặp thuốc khác" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="210" width="510" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="prep" target="split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="clabel" value="&lt;b&gt;Khối C — bốn điều kiện mạng. Cùng một kiến trúc GCN, bốn lần train.&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="800" height="25" as="geometry" />
        </mxCell>

        <mxCell id="cond1" value="&lt;b&gt;Mạng THẬT&lt;/b&gt;&lt;br&gt;STRING ≥ 700&lt;br&gt;&lt;br&gt;5 seed × 5 fold&lt;br&gt;= 25 lần train" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="335" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cond2" value="&lt;b&gt;XÁO₁ giữ bậc&lt;/b&gt;&lt;br&gt;double_edge_swap, seed A&lt;br&gt;&lt;br&gt;25 lần train&lt;br&gt;(xáo lại ở MỖI seed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="315" y="335" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cond3" value="&lt;b&gt;XÁO₂ giữ bậc&lt;/b&gt;&lt;br&gt;double_edge_swap, seed B&lt;br&gt;&lt;br&gt;25 lần train&lt;br&gt;&lt;i&gt;đây là mạng để dựng NULL&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="335" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cond4" value="&lt;b&gt;m = 0&lt;/b&gt;&lt;br&gt;không có mạng&lt;br&gt;&lt;br&gt;25 lần train&lt;br&gt;&lt;i&gt;đối chiếu cho điều kiện tiên quyết&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="885" y="335" width="265" height="110" as="geometry" />
        </mxCell>

        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="split" target="cond1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="split" target="cond2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="split" target="cond3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="split" target="cond4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="base" value="&lt;b&gt;Khối B — mốc so sánh, cùng split&lt;/b&gt;&lt;br&gt;&lt;br&gt;one-hot MLP (25 lần train)   |   MLP kiểu DeepSynergy (25 lần train)   |   s_AB của Cheng (công thức, KHÔNG train)   |   đường ngắn nhất (hàm networkx, KHÔNG train)&lt;br&gt;&lt;br&gt;Hai cái đầu so hiệu năng dự đoán. Hai cái sau so lời giải thích, và đường ngắn nhất chính là null của RQ2." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="480" width="1120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="g6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="split" target="base">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="gate" value="&lt;b&gt;GATE — mô hình có dùng mạng không?&lt;/b&gt;&lt;br&gt;network share khác 0 rõ   VÀ   QWK(m=1) &amp;gt; QWK(m=0)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="640" width="610" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="base" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ngate" value="&lt;b&gt;Không qua gate thì VẪN chạy tiếp.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;Mô hình không dùng mạng, mà explainer vẫn in ra đường dẫn trông hợp lý&quot; là một kết quả mạnh hơn nhiều so với chỉ &quot;mô hình không dùng mạng&quot;.&lt;br&gt;&lt;br&gt;Đây là chỗ bản 2 khác bản 1: bản 1 coi đây là điều kiện chặn." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="630" width="240" height="180" as="geometry" />
        </mxCell>

        <mxCell id="ig1" value="&lt;b&gt;Khối D&lt;/b&gt;&lt;br&gt;edge-IG 3 cấp&lt;br&gt;trên mạng THẬT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="780" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ig2" value="&lt;b&gt;Khối D&lt;/b&gt;&lt;br&gt;edge-IG 3 cấp&lt;br&gt;trên XÁO₁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="780" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ig3" value="&lt;b&gt;Khối D&lt;/b&gt;&lt;br&gt;edge-IG 3 cấp&lt;br&gt;trên XÁO₂" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="780" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="gate" target="ig1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="gate" target="ig2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="gate" target="ig3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="extract" value="Trích top-k GEN và top-k ĐƯỜNG DẪN cho từng điều kiện (chi tiết ở trang 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="900" width="610" height="55" as="geometry" />
        </mxCell>
        <mxCell id="g11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="ig1" target="extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="ig2" target="extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="ig3" target="extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rq1" value="&lt;b&gt;RQ1 — topo&lt;/b&gt;&lt;br&gt;&lt;br&gt;survival(THẬT, XÁO₁)&lt;br&gt;− survival(XÁO₁, XÁO₂)&lt;br&gt;&lt;br&gt;Hiệu ≈ 0: mạng thật không đặc biệt hơn một mạng xáo bất kỳ.&lt;br&gt;Hiệu âm rõ: lời giải thích có phụ thuộc mạng thật.&lt;br&gt;&lt;br&gt;Báo thêm một bản BỎ đích thuốc khỏi top-k, vì đích luôn sống sót trên mọi mạng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="1000" width="355" height="230" as="geometry" />
        </mxCell>
        <mxCell id="rq2" value="&lt;b&gt;RQ2 — danh tính&lt;/b&gt;&lt;br&gt;&lt;br&gt;spec(edge-IG)&lt;br&gt;− spec(đường ngắn nhất)&lt;br&gt;&lt;br&gt;spec = 1 − mean Jaccard( T(A,B,c), T(A,r,c) ), bỏ đích A và B khỏi T, r không chung đích với B.&lt;br&gt;&lt;br&gt;So cấp (i) với cấp (iii).&lt;br&gt;Giả thuyết: cấp (iii) cho hiệu lớn hơn." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="405" y="1000" width="355" height="230" as="geometry" />
        </mxCell>
        <mxCell id="rqf" value="&lt;b&gt;Trung thực&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fid+ / Fid−&lt;br&gt;− null xoá cạnh ngẫu nhiên cùng số lượng&lt;br&gt;&lt;br&gt;Stability: cosine giữa 5 seed&lt;br&gt;&lt;br&gt;Không có ROAR. Fid± có null đã đủ, ROAR phải train lại sau mỗi lần xoá." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="1000" width="370" height="230" as="geometry" />
        </mxCell>
        <mxCell id="g14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="extract" target="rq1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="extract" target="rq2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="extract" target="rqf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="case" value="&lt;b&gt;Case study — chương riêng, KHÔNG phải phép thử chính&lt;/b&gt;&lt;br&gt;&lt;br&gt;2–3 cặp đối chứng dương trong O&#39;Neil: PD325901 + MK-2206  |  MK-8776 + gemcitabine  |  ABT-888 + temozolomide&lt;br&gt;Chấm bằng gene set KEGG và DepMap CRISPR, so với null 1.000 đường ngẫu nhiên cùng độ dài. Báo theo từng cặp, không gộp.&lt;br&gt;&lt;br&gt;KEGG chỉ xuất hiện ở đây. Mạng là STRING, để không tự chấm điểm chính mình." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="1270" width="1120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="g17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="rq2" target="case">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="out1" value="&lt;b&gt;Kết cục 1 — bài phương pháp + benchmark&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lời giải thích trung thực, đổi khi xáo mạng, và đặc hiệu theo cặp.&lt;br&gt;&lt;br&gt;→ Có một cách giải thích đáng tin, kèm giao thức kiểm định có hiệu chỉnh null." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="1430" width="545" height="140" as="geometry" />
        </mxCell>
        <mxCell id="out2" value="&lt;b&gt;Kết cục 2 — bài phản biện&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lời giải thích vẫn y nguyên trên mạng xáo, hoặc không đặc hiệu theo cặp.&lt;br&gt;&lt;br&gt;→ Các &quot;đường dẫn cơ chế&quot; đã công bố có thể là sản phẩm của việc nhớ danh tính. Cùng dòng với One-hot news." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="605" y="1430" width="545" height="140" as="geometry" />
        </mxCell>
        <mxCell id="g18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="case" target="out1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="case" target="out2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="Cả hai kết cục đều đăng được. Một bài journal gộp, nộp tháng 10. Tổng 100 lần train khối A + 50 lần train baseline, khoảng 5 giờ máy." style="text;html=1;fontSize=13;align=center;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="1585" width="1120" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
